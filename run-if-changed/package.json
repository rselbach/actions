{
  "name": "run-if-changed",
  "version": "0.0.1",
  "engines": {
    "node": ">= 24"
  },
  "private": true,
  "description": "Execute your workflow steps only if relevant files are modified.",
  "type": "module",
  "scripts": {
    "build": "ncc build src/main.js -o dist",
    "format": "prettier --write \"src/**/*.js\"",
    "lint": "eslint \"src/**/*.js\"",
    "all": "npm run format && npm run lint && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/github": "9.1.1",
    "js-yaml": "^4.3.1",
    "picomatch": "^2.3.2"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.56.0",
    "prettier": "^2.8.8"
  }
}
